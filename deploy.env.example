# Copy to .env and replace every CHANGE_ME value. Never commit .env.
COMPOSE_PROJECT_NAME=nextwireless-dev2
# Prefer an immutable company-registry tag or digest. For an approved local
# build, use a local tag and set DEPLOY_BUILD_LOCAL=true.
APP_IMAGE=CHANGE_ME_REGISTRY/nextwireless-dev2-data-plane:CHANGE_ME_TAG
# Offline alternative. Bundle generation fills these values automatically.
APP_IMAGE_ARCHIVE=
APP_IMAGE_ARCHIVE_SHA256=
DEPLOY_BUILD_LOCAL=false
# standalone = core only. integrated = core + Realtime Status/Event + Alarm Outbox.
DEPLOY_MODE=standalone
ENABLE_SNAPSHOT_RECONCILIATION=false
PG_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DP_INBOUND_TOKEN=CHANGE_ME_RANDOM_SERVICE_TOKEN
DP_INBOUND_ALLOWED_ORGS=hainam

# Bind API locally unless a trusted reverse proxy requires a private interface.
DATA_API_BIND_IP=127.0.0.1
DATA_API_PORT=8002

# ESP32 devices need a reachable private/LAN address. Do not use 0.0.0.0 by default.
MQTT_BIND_IP=CHANGE_ME_PRIVATE_SERVER_IP
MQTT_PORT=8883
MQTT_DEVICE_RATE_PER_SECOND=1.25

# Fast Presence remains disabled unless explicitly approved per device.
FAST_PRESENCE_DEVICE_IDS=
FAST_PRESENCE_TIMEOUT_SECONDS=4
FAST_PRESENCE_RECONCILE_SECONDS=0.5

# Optional Dev 1 integration. Profiles are not started by deploy.sh unless requested.
DEV1_BASE_URL=
DEV1_API_KEY=
DEV1_API_SECRET=
FRAPPE_SITE_NAME=
DEV1_DEVICE_EVENT_METHOD=nextwireless_dashboard.api.ingestion.receive_device_event
DEV1_CONFIG_URL=
DEV1_CONFIG_DEVICE_IDS=
DEV1_SITE_NAME=
DEV1_ALLOW_INSECURE_LAB=false

# All outbound delivery is fail-closed by default.
OUTBOX_DELIVERY_ENABLED=false
BRIDGE_MODE=mock
BRIDGE_ALARM_PROTOCOL=mock
BRIDGE_ALARM_URL=
BRIDGE_STATUS_URL=
IF05_E2E_ARMED=false
IF05_E2E_HIGH_WATER_ID=
IF05_E2E_ARMED_AT=
IF05_E2E_ORG=
IF05_E2E_DEVICES=
IF05_E2E_RULES=
REALTIME_E2E_ARMED=false
REALTIME_EVENT_HIGH_WATER_ID=
REALTIME_STATUS_HIGH_WATER_ID=
REALTIME_ARMED_AT=
REALTIME_ORG=
REALTIME_DEVICES=
