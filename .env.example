# LOCAL DEVELOPMENT ONLY. Set a fresh strong password; keep this file private.
PG_PASSWORD=CHANGE_ME_TO_A_STRONG_LOCAL_PASSWORD
DP_INBOUND_TOKEN=CHANGE_ME_TO_A_RANDOM_SERVICE_TOKEN
DP_INBOUND_ALLOWED_ORGS=demo
BRIDGE_OUTBOUND_TOKEN=CHANGE_ME_WHEN_DEV1_PROVIDES_A_TOKEN
# Keep these Mock defaults until the real Bridge URL, token, and schema are verified.
BRIDGE_MODE=mock
BRIDGE_ALARM_URL=http://mock-nextgrp:8080/internal/events/alarm
BRIDGE_STATUS_URL=http://mock-nextgrp:8080/internal/events/status
BRIDGE_SNAPSHOT_URL=http://mock-nextgrp:8080/internal/snapshot
BRIDGE_SNAPSHOT_TOKEN=mock-development-token
BRIDGE_ALLOW_INSECURE_HTTP=true
# Set this to the UTC activation timestamp before switching to Real; older rows are never claimed.
BRIDGE_DELIVER_NOT_BEFORE=

# Simulator registry identity. Credentials remain in .secrets/mqtt-simulator.env.
SIM_ORG_CODE=demo
SIM_SITE_CODE=demo-site
SIM_S1_DEVICE_ID=TH-001
SIM_S6_DEVICE_ID=DR-001

# Generate ignored MQTT credentials and development certificates with:
# powershell -ExecutionPolicy Bypass -File scripts/generate-dev-mqtt-assets.ps1
